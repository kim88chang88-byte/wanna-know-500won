# 복사해서 .env.local 로 만들고 실제 값을 채워 넣으세요. (.env.local 은 git에 올라가지 않습니다)

# AI 풀이용 Claude API 키 (서버에서만 사용합니다. 절대 NEXT_PUBLIC_ 을 붙이지 마세요)
# 비워 두면 풀이 없이 사주 네 기둥만 보여줘요.
ANTHROPIC_API_KEY=

# (선택) 풀이에 쓸 모델. 비우면 claude-haiku-5-5 (가볍고 저렴). 품질을 더 올리고 싶으면 claude-sonnet-5-5 등으로 바꾸세요.
ANTHROPIC_MODEL=

# Google Stitch API 키 (docs/STITCH.md 참고)
# 주의: .mcp.json 은 .env.local 이 아니라 셸 환경변수에서 값을 읽습니다.
STITCH_API_KEY=

# ---- 카카오 로그인 (docs/KAKAO_LOGIN.md 참고) ----
# 카카오 개발자 콘솔 > 앱 > 앱 키 의 "REST API 키"
KAKAO_CLIENT_ID=
# 카카오 로그인 > 보안 > Client secret 을 켜 두었다면 그 값 (서버에서만 사용)
KAKAO_CLIENT_SECRET=
# 로그인 후 돌아올 주소. 비우면 접속 주소 + /api/auth/kakao/callback 을 써요. 콘솔의 Redirect URI 와 똑같아야 해요.
KAKAO_REDIRECT_URI=
# 로그인 쿠키 서명용 비밀키. 32자 이상 무작위 문자열 (예: openssl rand -base64 32)
AUTH_SECRET=

# ---- 배포용 (선택) ----
# 배포 주소. 카카오톡 등에 링크를 공유할 때 미리보기 주소의 기준이 돼요. 예: https://내도메인.kr
NEXT_PUBLIC_SITE_URL=

# ---- Supabase DB (docs/SUPABASE.md 참고) ----
# Project Settings > API 의 Project URL
SUPABASE_URL=
# Project Settings > API 의 service_role 키 (서버에서만 사용. 절대 NEXT_PUBLIC_ 을 붙이거나 공개하지 마세요)
SUPABASE_SERVICE_ROLE_KEY=
# true 로 하면 "오늘 무료 1회"를 쓴 로그인 회원은 결제 없이 더 뽑을 수 없어요. (결제를 열 때 켜세요. 기본은 꺼짐=기록만)
DAILY_FREE_LIMIT_ENFORCED=

# 구글 로그인 (docs/GOOGLE_LOGIN.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 비워 두면 요청 주소 기준 /api/auth/google/callback 을 써요
GOOGLE_REDIRECT_URI=
